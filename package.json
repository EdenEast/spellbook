{
  "name": "spellbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal agent instructions, skills, references, and Pi extensions for Codex, Claude Code, and Pi.",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test scripts/tests/*.test.ts",
    "status": "node scripts/install.ts status",
    "resources:install": "node scripts/install.ts install",
    "resources:uninstall": "node scripts/install.ts uninstall"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi/extensions"
    ],
    "skills": ["./skills"],
    "prompts": [],
    "themes": []
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "bin": {
    "spellbook": "scripts/spellbook.ts"
  }
}
